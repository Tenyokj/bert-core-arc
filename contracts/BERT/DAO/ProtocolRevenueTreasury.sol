pragma solidity ^0.8.28;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {IProtocolRevenuePool} from "../interfaces/IProtocolRevenuePool.sol";

/**
 * @title ProtocolRevenueTreasury
 * @notice Receives earned protocol fees and distributes them to fixed beneficiaries.
 * @dev Non-upgradeable and ownerless. Anyone may relay collection or a beneficiary's
 *      payout, but cannot choose its destination. No arbitrary calls, approvals,
 *      emergency sweep or mutable split exists. Direct USDC donations are distributed
 *      by the same split; unrelated tokens cannot be recovered. Supports only the
 *      pool's exact-transfer, non-rebasing USDC. Rounding dust remains in the Treasury.
 * @custom:version 1.0.0
 */
contract ProtocolRevenueTreasury is ReentrancyGuard {
    using SafeERC20 for IERC20;

    /* ========== CONSTANTS ========== */

    /// @notice Denominator used for beneficiary shares.
    uint256 public constant BPS = 10_000;

    /// @notice Maximum number of immutable beneficiaries.
    uint256 public constant MAX_PAYEES = 16;

    /* ========== CONTRACTS ========== */

    /// @notice FundingPool proxy from which this Treasury can collect its entitlement.
    address public immutable fundingPool;

    /// @notice Token received and distributed; permanently fixed at deployment.
    IERC20 public immutable usdc;

    /* ========== STORAGE ========== */

    /// @notice Cumulative USDC paid to all beneficiaries.
    uint256 public totalReleased;

    /// @notice Immutable share in basis points for each beneficiary.
    mapping(address => uint256) public shares;

    /// @notice Cumulative USDC paid to a beneficiary.
    mapping(address => uint256) public released;

    /// @dev Enumerable fixed beneficiary list; shares sum to BPS.
    address[] private payees;

    /* ========== ERRORS AND EVENTS ========== */

    /// @notice Source pool, token or beneficiary split is invalid.
    error InvalidRevenueTreasury();

    /// @notice The specified beneficiary has no payable entitlement.
    error NothingToRelease();

    /// @notice A transfer did not credit its destination with the exact requested amount.
    error UnsupportedRevenueTransfer();

    /// @notice Records an immutable beneficiary and its share.
    /// @param payee Address receiving its own entitlement.
    /// @param shareBps Share of Treasury receipts in basis points.
    event PayeeAdded(address indexed payee, uint256 shareBps);

    /// @notice Records revenue collected from FundingPool.
    /// @param amount Earned USDC received.
    event RevenueCollected(uint256 amount);

    /// @notice Records an actual beneficiary payment.
    /// @param payee Immutable destination of the payment.
    /// @param amount USDC paid.
    event RevenueReleased(address indexed payee, uint256 amount);

    /* ========== CONSTRUCTOR ========== */

    /**
     * @notice Fixes the pool, token, beneficiaries and their complete split.
     * @param pool FundingPool proxy, not its implementation.
     * @param token Exact-transfer USDC matching the source pool.
     * @param beneficiaries Unique nonzero recipients, at most MAX_PAYEES.
     * @param shareBps Nonzero shares summing to exactly BPS.
     * @dev Recipient rotation requires deploying a new Treasury. Existing round
     *      entitlements remain payable under the original Treasury's fixed split.
     */
    constructor(address pool, IERC20 token, address[] memory beneficiaries, uint256[] memory shareBps) {
        if (
            pool.code.length == 0 || address(token).code.length == 0 ||
            beneficiaries.length == 0 || beneficiaries.length > MAX_PAYEES ||
            beneficiaries.length != shareBps.length || IProtocolRevenuePool(pool).usdc() != token
        ) revert InvalidRevenueTreasury();
        fundingPool = pool;
        usdc = token;
        uint256 sum;
        for (uint256 i; i < beneficiaries.length; ++i) {
            address payee = beneficiaries[i];
            uint256 share = shareBps[i];
            if (
                payee == address(0) || payee == address(this) || payee == pool ||
                shares[payee] != 0 || share == 0 || share > BPS
            ) revert InvalidRevenueTreasury();
            shares[payee] = share;
            payees.push(payee);
            sum += share;
            emit PayeeAdded(payee, share);
        }
        if (sum != BPS) revert InvalidRevenueTreasury();
    }

    /* ========== EXTERNAL FUNCTIONS ========== */

    /**
     * @notice Collects this Treasury's earned fees without affecting grant execution.
     * @param amount Amount to collect from the source pool.
     * @dev Permissionless relay; FundingPool pays only this contract's entitlement.
     *      A collection failure cannot revert a previously completed grant tranche.
     */
    function collect(uint256 amount) external nonReentrant {
        uint256 beforeBalance = usdc.balanceOf(address(this));
        IProtocolRevenuePool(fundingPool).claimProtocolRevenue(amount);
        if (usdc.balanceOf(address(this)) != beforeBalance + amount) revert UnsupportedRevenueTransfer();
        emit RevenueCollected(amount);
    }

    /**
     * @notice Pays all currently releasable USDC to an immutable beneficiary.
     * @param payee Beneficiary to pay, never the relayer's alternative destination.
     * @dev A failed token transfer rolls back entitlement consumption. One payee's
     *      transfer failure does not prevent separate calls for other beneficiaries.
     */
    function release(address payee) external nonReentrant {
        uint256 amount = releasable(payee);
        if (amount == 0) revert NothingToRelease();
        released[payee] += amount;
        totalReleased += amount;
        uint256 beforeBalance = usdc.balanceOf(payee);
        uint256 treasuryBalance = usdc.balanceOf(address(this));
        usdc.safeTransfer(payee, amount);
        if (
            usdc.balanceOf(payee) != beforeBalance + amount ||
            usdc.balanceOf(address(this)) != treasuryBalance - amount
        ) revert UnsupportedRevenueTransfer();
        emit RevenueReleased(payee, amount);
    }

    /* ========== VIEW FUNCTIONS ========== */

    /// @notice Returns the number of immutable beneficiaries.
    /// @return count Number of beneficiary addresses.
    function payeeCount() external view returns (uint256 count) {
        return payees.length;
    }

    /// @notice Returns one beneficiary; an invalid index reverts.
    /// @param index Zero-based beneficiary index.
    /// @return payee Immutable beneficiary address.
    function payeeAt(uint256 index) external view returns (address payee) {
        return payees[index];
    }

    /// @notice Previews a beneficiary's unpaid share of all Treasury USDC receipts.
    /// @param payee Beneficiary whose entitlement is queried.
    /// @return amount Unpaid USDC; zero for an unknown beneficiary.
    function releasable(address payee) public view returns (uint256 amount) {
        uint256 received = usdc.balanceOf(address(this)) + totalReleased;
        return Math.mulDiv(received, shares[payee], BPS) - released[payee];
    }
}
