pragma solidity ^0.8.20;

/**
 * @title IGlobalBertReserve
 * @notice Accounting-aware receiver for BERT V3 capital routed into the V2 protocol reserve.
 * @dev Production implementation is FundingPoolUpgradeable after its V3 reserve adapter upgrade.
 */
interface IGlobalBertReserve {
    /**
     * @notice Pulls and records USDC that a validated V3 community routes into the protocol reserve.
     * @param amount USDC amount in token-native units.
     */
    function receiveCommunityReserve(uint256 amount) external;
}
