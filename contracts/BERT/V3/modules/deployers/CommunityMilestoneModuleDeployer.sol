pragma solidity ^0.8.20;

import {ICommunityMilestoneTreasury} from "../../interfaces/ICommunityMilestoneTreasury.sol";
import {CommunityWinnerSnapshot} from "../CommunityWinnerSnapshot.sol";
import {CommunityMilestoneManager} from "../CommunityMilestoneManager.sol";

/** @notice Stateless deployment boundary for V3.1 winner snapshots and milestone plans. */
/**
 * @title CommunityMilestoneModuleDeployer
 * @notice Stateless deployment helper for the V3.1 milestone manager.
 * @custom:version 1.1.0
 */
contract CommunityMilestoneModuleDeployer {
    function deploy(
        address hub,
        address votingModule,
        address executionRecipient,
        ICommunityMilestoneTreasury treasury,
        uint64 reviewDuration,
        uint64 proofDuration
    ) external returns (CommunityWinnerSnapshot snapshot, CommunityMilestoneManager manager) {
        snapshot = new CommunityWinnerSnapshot(votingModule);
        manager = new CommunityMilestoneManager(
            hub, votingModule, executionRecipient, treasury, snapshot, reviewDuration, proofDuration
        );
    }
}
