pragma solidity ^0.8.20;

/**
 * @title ICommunityFactoryRegistry
 * @notice Minimal V3 Factory view used by the V2 FundingPool reserve adapter.
 */
interface ICommunityFactoryRegistry {
    /**
     * @notice Returns whether a Treasury belongs to a fully activated BERT V3 community.
     * @param treasury Treasury address being checked.
     * @return True when the Treasury has been linked to its validated CommunityHub.
     */
    function isActiveCommunityTreasury(address treasury) external view returns (bool);
}
