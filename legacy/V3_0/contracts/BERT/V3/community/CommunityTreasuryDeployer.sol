pragma solidity ^0.8.20;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";

import {CommunityTreasury} from "./CommunityTreasury.sol";
import {ICommunityTreasuryDeployer} from "../interfaces/ICommunityTreasuryDeployer.sol";

/**
 * @title CommunityTreasuryDeployer
 * @notice Deploys CommunityTreasury instances without bloating CommunityFactory runtime code.
 * @dev The supplied Factory remains the only account that can bind the new Treasury to a Hub.
 * 
 * @custom:version 1.0.0
 */
contract CommunityTreasuryDeployer is ICommunityTreasuryDeployer {
    /**
     * @notice Deploys an isolated immutable Treasury for one pending community.
     * @dev Only the supplied Factory address receives the right to bind the deployed Treasury to a Hub.
     * @param usdc USDC-compatible token accepted for every community flow.
     * @param globalBertReserve Accounting-aware V2 FundingPool reserve receiver.
     * @param factory CommunityFactory proxy authorized to call setCommunityHub on the new Treasury.
     * @return treasury Newly deployed CommunityTreasury address.
     */
    function deployCommunityTreasury(
        address usdc,
        address globalBertReserve,
        address factory
    ) external override returns (address treasury) {
        return address(new CommunityTreasury(IERC20(usdc), globalBertReserve, factory));
    }
}
