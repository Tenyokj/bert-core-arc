pragma solidity ^0.8.20;

import {CommunityTypes} from "../libraries/CommunityTypes.sol";

/**
 * @title ICommunityFactory
 * @notice Registry and deployment entrypoint for BERT V3 communities.
 */
interface ICommunityFactory {
    /**
     * @notice Returns the protocol-wide proof-of-personhood verifier required by new communities.
     * @return Verifier contract address fixed when the Factory proxy is initialized.
     */
    function humanVerifier() external view returns (address);

    /**
     * @notice Emitted when Factory deploys and reserves a Treasury for a new community.
     * @param communityId Monotonic Factory-assigned community identifier.
     * @param creator Account that created the community.
     * @param configHash Hash of the immutable configuration that a later Hub must match.
     * @param treasury Deployed CommunityTreasury address.
     * @param name Community display name.
     * @param metadataURI Offchain community metadata.
     */
    event CommunityTreasuryCreated(
        uint256 indexed communityId,
        address indexed creator,
        address treasury,
        bytes32 configHash,
        string name,
        string metadataURI
    );

    /**
     * @notice Emitted when the community creator links their validated Hub to its reserved Treasury.
     * @param communityId Factory-assigned community identifier.
     * @param creator Community creator that completed activation.
     * @param hub Validated CommunityHub address.
     * @param treasury Previously reserved CommunityTreasury address.
     */
    event CommunityCreated(uint256 indexed communityId, address indexed creator, address indexed hub, address treasury);

    /**
     * @notice Deploys and reserves a Treasury for an independently governed BERT V3 community.
     * @dev The creator then deploys CommunityHub directly and calls activateCommunity. This avoids
     * embedding the large CommunityHub creation bytecode in a deployer contract.
     * @param config_ Immutable configuration selected by the community creator.
     * @return communityId Factory-assigned community identifier.
     * @return treasury Deployed CommunityTreasury address.
     */
    function createCommunity(CommunityTypes.CommunityConfig calldata config_)
        external
        returns (uint256 communityId, address treasury);

    /**
     * @notice Verifies and links a directly deployed CommunityHub to a pending community Treasury.
     * @param communityId Factory-assigned pending community identifier.
     * @param hub CommunityHub deployed by the recorded creator with the reserved Treasury address.
     */
    function activateCommunity(uint256 communityId, address hub) external;

    /**
     * @notice Returns the deployment record for a community.
     * @param communityId Factory-assigned community identifier.
     */
    function getCommunity(uint256 communityId)
        external
        view
        returns (CommunityTypes.CommunityDeployment memory);

    /**
     * @notice Returns the Factory IDs created by one account.
     * @param creator Community creator address.
     */
    function getCreatorCommunityIds(address creator) external view returns (uint256[] memory);

    /**
     * @notice Returns whether a Treasury belongs to a fully activated BERT V3 community.
     * @param treasury Treasury address being checked.
     * @return True when the Treasury has been linked to its validated CommunityHub.
     */
    function isActiveCommunityTreasury(address treasury) external view returns (bool);
}
